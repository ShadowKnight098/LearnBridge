# Database Configuration
DATABASE_URL=postgresql://learnbridge:learnbridge@localhost:5432/learnbridge
# When running inside docker compose:
# DATABASE_URL=postgresql://learnbridge:learnbridge@db:5432/learnbridge

# JWT and Authentication Security
JWT_SECRET=learnbridge-dev-secret-key-32-chars-long-min-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# LLM Configuration (options: gemini | ollama | none)
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
OLLAMA_BASE_URL=http://localhost:11434

# Application & CORS Settings
FRONTEND_ORIGIN=http://localhost:3000
DAILY_SESSION_CAP=5
PORT=8000
ENVIRONMENT=development
